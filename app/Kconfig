menuconfig LED_SUBSYSTEM
    bool "LED Subsystem"
    default y

if LED_SUBSYSTEM

choice LED_SLEEP_TIME_MS
    prompt "LED blink sleep time"
    default LED_SLEEP_TIME_1000MS

config LED_SLEEP_TIME_250MS
    bool "250 ms (fast)"

config LED_SLEEP_TIME_1000MS
    bool "1s (medium)"

config LED_SLEEP_TIME_2000MS
    bool "2s (slow)"

endchoice

config LED_SLEEP_TIME_MS
    int
    default 250 if LED_SLEEP_TIME_250MS
    default 1000 if LED_SLEEP_TIME_1000MS
    default 2000 if LED_SLEEP_TIME_2000MS

menuconfig LED_ADVANCED
    bool "Advanced LED Settings"
    default n

if LED_ADVANCED

config LED_BRIGHTNESS
    int "LED Brightness (0-100)"
    range 0 100
    default 100

config LED_FADE_DURATION
    int "LED Fade Duration (ms)"
    range 0 5000
    default 500

menu "Expert Settings"

config LED_DEBUGGING
    bool "Enable LED Debugging"
    default n

config LED_CUSTOM_BLINK_PATTERN
    bool "Custom blink pattern"
    default n

endmenu
endif # LED_ADVANCED
endif # LED_SUBSYSTEM

source "Kconfig.zephyr"